# ==========================================
# Minecraft Server & Fabric
# ==========================================
# Monde de jeu (fichiers binaires fréquents, géré par backup.sh) + anciens mondes gardés à côté
server/world/
server/world-*/

# Cache, versions et bibliothèques téléchargées automatiquement par Fabric
server/libraries/
server/versions/
server/.fabric/

# Logs et rapports de crash
server/logs/
server/*.log
server/crash-reports/

# Cache utilisateur généré à chaud
server/usercache.json

# Fichiers générés par les mods au démarrage
server/.mixin.out/
server/dynamic-data-pack-cache/
server/defaultconfigs/
server/emotes/
server/moonlight-global-datapacks/
# Configs de mods générées : seules celles qu'on modifie sont suivies (MODS.md §6 étape 6)
server/config/*
!server/config/friendsandfoes.json
!server/config/textile_backup.json5

# Mods binaires (évite de saturer Git avec des dizaines de Mo de JARs)
server/mods/*.jar
!server/mods/.gitkeep

# Instance de test jetable des mods (voir TEST-MODS.md)
test-server/

# .mrpack construits pour les amis (distribués via Discord ; source du pack = pack/)
client-pack/*.mrpack

# ==========================================
# Sauvegardes
# ==========================================
backups/*
!backups/.gitkeep
*.tar.gz

# ==========================================
# Tunnel Playit & Données sensibles / Secrets
# ==========================================
# Clés et codes d'association Playit
playit/secret.txt
playit/claim-code.txt

# Binaire Linux utilisé pour générer le claim code
playit/playit-cli

# Fichiers sensibles génériques
*.key
*.token
.env*

# ==========================================
# Système & Éditeurs
# ==========================================
.DS_Store
.claude/
.idea/
.vscode/

# Workspace multi-dépôts VSCode (chemins locaux vers les dépôts frères)
*.code-workspace
